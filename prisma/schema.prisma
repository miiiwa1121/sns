// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// 1. チャンネル / ブランド アカウント (マルチアカウント基盤)
model Account {
  id                String   @id @default(cuid())
  name              String // アカウント表示名 (例: 「AI速報スタジオ」)
  slug              String   @unique // URL用識別子 (例: "ai-news")
  category          String // メインカテゴリ (例: "AI・IT")
  concept           String // チャンネルコンセプト
  targetAudience    String // 想定ペルソナ・ターゲット層
  defaultTemplateId String? // 既定の構成案（依頼時に選び直せる）
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // リレーション
  platformConnections PlatformConnection[]
  projects            Project[]
  trendResearches     TrendResearch[]
  agentKnowledges     AgentKnowledge[]
  agentJobs           AgentJob[]
  templateWorkshops   TemplateWorkshop[]
  defaultTemplate     StructureTemplate?   @relation(fields: [defaultTemplateId], references: [id], onDelete: SetNull)
}

// 2. SNS連携情報 (YouTube, TikTok, Instagram, X)
model PlatformConnection {
  id          String   @id @default(cuid())
  accountId   String
  platform    String // "youtube" | "tiktok" | "instagram" | "x"
  handle      String // アカウント名・ハンドル (例: "@ai_news_ch")
  apiConfig   String? // API設定やトークンのJSON (暗号化または設定値)
  isConnected Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// 3. トレンドリサーチ履歴
model TrendResearch {
  id             String   @id @default(cuid())
  accountId      String
  topic          String
  category       String
  buzzScore      Int? // 実測できる指標が無い場合は null（推測値を入れない）
  searchVolume   String?
  trendVelocity  String?
  suggestedAngle String
  summary        String? // リサーチで分かった事実の要約
  sourcesJson    String? // 出典 [{ title, url }] の JSON
  createdAt      DateTime @default(now())

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  projects Project[]
}

// 4. 動画企画プロジェクト
model Project {
  id              String   @id @default(cuid())
  accountId       String
  title           String
  concept         String
  stage           String   @default("research") // "research" | "production" | "review" | "published" | "analyzed"
  targetAudience  String?
  estimatedViews  String?
  trendResearchId String? // 企画の元になったリサーチ（出典の追跡用）
  templateId      String? // 台本づくりに使った構成案（依頼から引き継ぐ。分析で構成案ごとに比べる）
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account       Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  trendResearch TrendResearch?       @relation(fields: [trendResearchId], references: [id], onDelete: SetNull)
  template      StructureTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  longFormVideo LongFormVideo?
  shortClips    ShortClip[]
  publishLogs   PublishLog[]
  analytics     AnalyticsMetric[]
  agentJobs     AgentJob[]
  editMessages  ProjectEditMessage[]
}

// 5. 長尺動画マスター構成・台本
model LongFormVideo {
  id           String   @id @default(cuid())
  projectId    String   @unique
  title        String
  description  String
  durationSec  Int
  thumbnailUrl String?
  status       String   @default("drafting") // "drafting" | "rendered" | "approved" | "published"
  scriptJson   String // チャプター分割・ナレーション配列のJSON
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// 6. 切り抜きショート動画
model ShortClip {
  id                     String   @id @default(cuid())
  projectId              String
  title                  String
  startTimeSec           Int
  endTimeSec             Int
  durationSec            Int
  hookSentence           String // 冒頭1〜2秒のバズるフック
  captionStyle           String   @default("dynamic-bounce")
  aspectRatio            String   @default("9:16")
  estimatedRetentionRate Int      @default(80)
  bgmTrack               String?
  scriptJson             String? // ナレーション行 [{ text, caption? }] の JSON（ショート単体の台本）
  renderedFilePath       String? // レンダリング済み MP4 の data/ からの相対パス（例: projects/<id>/video.mp4。配信対象）
  renderedScriptJson     String? // 今の動画を作ったときの台本（scriptJson と違えば、台本を直した後まだ作り直していない）
  renderStatus           String   @default("idle") // 動画の作り直し: "idle" | "rendering" | "failed"
  renderPid              Int? // 作り直しを動かしているプロセスグループ（停止に使う）
  renderError            String? // 作り直しに失敗した理由
  readyToPublish         Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  publishLogs PublishLog[]
}

// 7. プラットフォーム別配信ログ & スケジュール
model PublishLog {
  id           String    @id @default(cuid())
  projectId    String
  shortClipId  String?
  platform     String // "youtube" | "tiktok" | "instagram" | "x"
  title        String?
  caption      String?
  tagsJson     String? // ハッシュタグ配列のJSON
  status       String    @default("draft") // "draft" | "scheduled" | "published" | "failed"
  postUrl      String? // 投稿後の実URL（実投稿に成功した場合のみ）
  externalId   String? // プラットフォーム側の動画ID（YouTube videoId 等。アナリティクス取得に使う）
  errorMessage String? // status = "failed" の理由（認証未設定・API エラー等）
  scheduledAt  DateTime?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shortClip ShortClip? @relation(fields: [shortClipId], references: [id], onDelete: SetNull)
}

// 8. アナリティクス実績
model AnalyticsMetric {
  id             String   @id @default(cuid())
  projectId      String
  platform       String // "youtube" | "tiktok" | "instagram" | "x"
  views          Int      @default(0)
  retentionRate  Float? // %（未取得なら null。YouTube Analytics は反映まで1〜2日かかる）
  likes          Int      @default(0)
  shares         Int      @default(0)
  comments       Int      @default(0)
  engagementRate Float    @default(0.0) // %
  topComment     String?
  collectedAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// 9. CriticAIによるアカウント別の学習知見 (PDCAメモリ)
model AgentKnowledge {
  id              String   @id @default(cuid())
  accountId       String
  category        String // "hook" | "tempo" | "topic" | "cta"
  ruleText        String // 学習知見ルール (例: 「冒頭に疑問文を置くとTikTokの維持率+18%」)
  confidenceScore Float    @default(0.85)
  appliedCount    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// 10. 動画づくりの依頼（管理画面から AI エージェントに依頼する）
model AgentJob {
  id           String    @id @default(cuid())
  accountId    String
  provider     String // "claude-code" | "antigravity"
  theme        String? // 依頼のテーマ（空ならおまかせ）
  status       String    @default("running") // "running" | "succeeded" | "failed" | "canceled"
  projectId    String? // エージェントが作った企画（project:create --job で紐づく）
  templateId   String? // 使った構成案
  templateName String? // 依頼した時点の構成案の名前（構成案を消しても残す）
  templateBody String? // 依頼した時点の構成案の本文（あとで構成案を編集しても、何で作ったか分かるように）
  pid          Int? // 実行中のプロセス（Claude Code のみ）
  error        String?
  createdAt    DateTime  @default(now())
  finishedAt   DateTime?

  account  Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project  Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  template StructureTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
}

// 11. サービス全体の設定（1行だけ。id = "app"）。管理画面の「設定」で編集する
model AppSetting {
  id                  String    @id @default("app")
  cleanupAuto         Boolean   @default(false) // 動画づくりの依頼が終わるたびに自動で整理する
  cleanupDays         Int       @default(30) // YouTube 公開・依頼の終了からこの日数がたったものを整理する
  cleanupIncludeVideo Boolean   @default(false) // 作業ファイルに加えて、動画とサムネも消す
  lastCleanupAt       DateTime? // 最後に整理した日時
  lastCleanupBytes    Int? // 最後に整理で消した量（バイト）
  // AI 連携（管理画面の「AI 連携」）。用途ごとに使う AI とモデル。モデルが空ならその AI の既定
  aiJobProvider       String    @default("claude-code") // 動画づくりの依頼の既定: "claude-code" | "antigravity"
  aiJobModel          String    @default("")
  aiWorkshopProvider  String    @default("claude-code") // 構成案の相談・試作: "claude-code" | "anthropic-api" | "gemini-api"
  aiWorkshopModel     String    @default("")
  aiEditProvider      String    @default("claude-code") // 動画編集の手直し: 同上
  aiEditModel         String    @default("")
  claudeBinPath       String? // Claude Code の場所（空なら ~/.local/bin/claude）
  antigravityBinPath  String? // Antigravity の場所（空なら既定の場所）
  updatedAt           DateTime  @updatedAt
}

// 12. 動画の構成案（指示書のうち「構成」の部分）。全アカウント共通の一覧で、各アカウントは既定を1つ選ぶ
// コマンド・手順・禁止事項は指示書（agent/job-prompt.ts）に固定で、ここでは編集できない
model StructureTemplate {
  id          String   @id @default(cuid())
  name        String // 例: 「標準（30〜50秒・ニュース解説）」
  description String? // 一覧に出す説明（どんな動画向けか）
  body        String // 指示書に差し込む構成の指示（尺・流れ・場面の使い方・字幕のルールなど）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accounts       Account[]
  projects       Project[]
  jobs           AgentJob[]
  workshops      TemplateWorkshop[] @relation("WorkshopBase")
  ownedWorkshops TemplateWorkshop[] @relation("WorkshopTemplate")
}

// 13. 構成案を AI と相談しながら作る場（管理画面の「構成案」→「AI と相談して作る」）
// 相談を始めた時点で構成案を作り（名前がなければ sample1, sample2 …）、名前の変更や AI の修正はその構成案に直接保存する。
// 既存の構成案を改善するときは複製（「◯◯ のコピー」）を作って直す（元の構成案と、それを使う依頼に影響させないため）
model TemplateWorkshop {
  id             String   @id @default(cuid())
  accountId      String // 相談の前提にするアカウント（コンセプト・視聴者・話し方）
  templateId     String // この相談で直している構成案（名前・説明・構成の指示はここに持つ）
  baseTemplateId String? // 複製の元にした構成案（新しく作った場合は null）
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  account      Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  baseTemplate StructureTemplate?        @relation("WorkshopBase", fields: [baseTemplateId], references: [id], onDelete: SetNull)
  template     StructureTemplate         @relation("WorkshopTemplate", fields: [templateId], references: [id], onDelete: Cascade)
  messages     TemplateWorkshopMessage[]
}

// 相談の1発言。AI の発言は作成時 pending で、別プロセス（agent/workshop-runner.ts）が中身を埋める
model TemplateWorkshopMessage {
  id           String   @id @default(cuid())
  workshopId   String
  role         String // "user" | "assistant"
  kind         String // "chat"（相談）| "sample"（試作）
  content      String   @default("") // 発言の本文（試作では AI のひとこと）
  proposedBody String? // AI が提案した構成の指示の全文（下書きに反映済み）
  sampleTopic  String? // 試作の話題
  sampleJson   String? // 試作の台本 { title, lines }（ブラウザで映像プレビューする）
  status       String   @default("done") // "pending" | "done" | "failed" | "canceled"（停止した）
  pid          Int? // AI を動かしているプロセス（停止に使う）
  error        String?
  createdAt    DateTime @default(now())

  workshop TemplateWorkshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
}

// 14. 動画編集画面（/projects/[id]/edit）で AI に台本の手直しを頼んだ記録
// AI の発言は pending で作り、別プロセス（agent/edit-runner.ts）が中身を埋める
model ProjectEditMessage {
  id        String   @id @default(cuid())
  projectId String
  role      String // "user" | "assistant"
  content   String   @default("")
  linesJson String? // AI が直した台本の全行（台本に反映済み）
  status    String   @default("done") // "pending" | "done" | "failed" | "canceled"
  pid       Int? // AI を動かしているプロセスグループ（停止に使う）
  error     String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
